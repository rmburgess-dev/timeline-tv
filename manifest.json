{
  "manifest_version": 3,
  "name": "Timeline TV",
  "version": "1.0.1",
  "description": "Watch your X/Twitter timeline as a grid of up to 8 videos playing at once.",
  "author": "Robert Burgess",

  "browser_specific_settings": {
    "gecko": {
      "id": "{8fcfa0d1-9f46-454f-8cbf-135344387f66}",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "permissions": ["storage"],

  "action": {
    "default_title": "Timeline TV",
    "default_popup": "popup.html",
    "default_area": "navbar",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    }
  },

  "background": {
    "scripts": ["background.js"]
  },

  "commands": {
    "toggle-slideshow": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Start or stop the slideshow on the current tab"
    }
  },

  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
